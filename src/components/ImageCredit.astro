---
interface Props {
  credit: string;
  license: string;
  license_url?: string;
  source_url: string;
  class?: string;
}
const { credit, license, license_url, source_url, class: className } = Astro.props;
const host = new URL(source_url).hostname.includes('wikimedia') ? 'Wikimedia Commons' : new URL(source_url).hostname;
---

<span class={className}>
  Photo: <a href={source_url} class="underline underline-offset-2">{credit}</a>{', '}
  {license_url ? <a href={license_url} rel="license" class="underline underline-offset-2">{license}</a> : license}{' '}via {host}
</span>
