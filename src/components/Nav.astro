---
import Logo from './Logo.astro';

// `short` is shown on phones; `icon` replaces the text there (label stays for screen readers).
const links: { href: string; label: string; short?: string; icon?: 'search'; desktopOnly?: boolean }[] = [
  { href: '/', label: 'States & UTs', short: 'States' },
  { href: '/search', label: 'Search', icon: 'search' },
  { href: '/about', label: 'About', desktopOnly: true },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' || path.startsWith('/states') : path === href);
---

<header class="sticky top-0 z-[1100] border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <nav aria-label="Main" class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
    <Logo />
    <ul class="flex items-center gap-0.5 text-sm font-medium sm:gap-2">
      {
        links.map((l) => (
          <li class:list={[l.desktopOnly && 'hidden sm:block']}>
            <a
              href={l.href}
              aria-current={isCurrent(l.href) ? 'page' : undefined}
              class="inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-full px-2.5 whitespace-nowrap text-slate-700 hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:bg-accent-50 aria-[current=page]:text-accent-800 sm:px-3"
            >
              {l.icon === 'search' && (
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-[18px] w-[18px]" fill="currentColor">
                  <path d="M8.5 3a5.5 5.5 0 1 0 3.4 9.83l3.64 3.63a1 1 0 0 0 1.41-1.41l-3.63-3.64A5.5 5.5 0 0 0 8.5 3Zm-3.5 5.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0Z" />
                </svg>
              )}
              {l.short ? (
                <>
                  <span class="sm:hidden">{l.short}</span>
                  <span class="hidden sm:inline">{l.label}</span>
                </>
              ) : (
                <span class:list={[l.icon && 'sr-only sm:not-sr-only']}>{l.label}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
