---
import type { CollectionEntry } from 'astro:content';
import { correctionLink } from '../site';
import { formatDate } from '../lib/format';

interface Props {
  state: CollectionEntry<'states'>['data'];
}
const { state } = Astro.props;
---

<section id="sources" aria-labelledby="sources-title" class="mt-12 rounded-3xl bg-sand-50 p-5 ring-1 ring-sand-200/70 sm:p-7">
  <p class="font-mono text-xs text-slate-500" aria-hidden="true">Sources</p>
  <h2 id="sources-title" class="font-display text-[clamp(1.6rem,4vw,2.25rem)] leading-tight font-bold text-slate-900">Where these facts come from</h2>
  <p class="mt-2 text-sm text-slate-700">
    Last updated {formatDate(state.last_updated)}. Statistics show the year they refer to.
  </p>
  <details class="group mt-4 rounded-2xl bg-white ring-1 ring-sand-200/70">
    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-4 text-sm font-semibold text-slate-900">
      Show all {state.sources.length} sources
      <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 transition group-open:rotate-180" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path></svg>
    </summary>
    <ol class="list-decimal space-y-2 border-t border-sand-200/70 px-4 py-4 pl-9 text-sm text-slate-800 marker:text-slate-500">
      {
        state.sources.map((s) => (
          <li>
            <a href={s.url} class="text-accent-800 underline underline-offset-2 break-words hover:text-accent-900">
              {s.title}
            </a>
            {s.supports && <span class="block text-slate-600">{s.supports}</span>}
          </li>
        ))
      }
    </ol>
  </details>

  {
    state.needs_verification.length > 0 && (
      <details class="group mt-3 rounded-2xl border border-amber-300 bg-amber-50 text-sm text-amber-950">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-4 font-semibold">
          <span>
            Still being checked <span class="font-normal">({state.needs_verification.length})</span>
          </span>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 shrink-0 transition group-open:rotate-180" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path></svg>
        </summary>
        <div class="border-t border-amber-200 px-4 py-4">
          <p>These details are on the page but have not yet been confirmed against a primary source:</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {state.needs_verification.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </details>
    )
  }

  <p class="mt-5">
    <a
      href={correctionLink(state.name)}
      class="inline-flex min-h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-sm font-semibold text-white hover:bg-accent-800"
    >
      Suggest a correction
      <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor"><path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L15 6.42V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z"></path><path d="M5 5a2 2 0 0 0-2 2v8c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z"></path></svg>
    </a>
  </p>
</section>
