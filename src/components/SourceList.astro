---
import type { CollectionEntry } from 'astro:content';
import { correctionLink } from '../site';
import { formatDate } from '../lib/format';

interface Props {
  state: CollectionEntry<'states'>['data'];
}
const { state } = Astro.props;
---

<section id="sources" aria-labelledby="sources-title" class="mt-12 rounded-2xl bg-sand-50 p-5 sm:p-6">
  <h2 id="sources-title" class="font-display text-2xl font-semibold text-slate-900">Sources</h2>
  <p class="mt-2 text-sm text-slate-700">
    Last updated {formatDate(state.last_updated)}. Statistics show the year they refer to.
  </p>
  <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-800 marker:text-slate-500">
    {
      state.sources.map((s) => (
        <li>
          <a href={s.url} class="text-accent-800 underline underline-offset-2 break-words hover:text-accent-900">
            {s.title}
          </a>
          {s.supports && <span class="block text-slate-600">{s.supports}</span>}
        </li>
      ))
    }
  </ol>

  {
    state.needs_verification.length > 0 && (
      <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
        <h3 class="font-semibold">Still being checked</h3>
        <p class="mt-1">These details are on the page but have not yet been confirmed against a primary source:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          {state.needs_verification.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    )
  }

  <p class="mt-6">
    <a
      href={correctionLink(state.name)}
      class="inline-flex items-center gap-2 rounded-lg border border-accent-700 bg-white px-4 py-2 text-sm font-semibold text-accent-800 hover:bg-accent-50"
    >
      Suggest a correction
      <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor"><path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L15 6.42V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z"></path><path d="M5 5a2 2 0 0 0-2 2v8c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z"></path></svg>
    </a>
  </p>
</section>
