---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../site';

interface Props {
  prev?: CollectionEntry<'states'>;
  next?: CollectionEntry<'states'>;
  neighbours: string[];
  /** Slugs of guides that are already published. */
  published: Set<string>;
}
const { prev, next, neighbours, published } = Astro.props;
---

<nav aria-label="More states" class="mt-12 space-y-6 border-t border-slate-200 pt-8">
  {
    neighbours.length > 0 && (
      <div>
        <h2 class="font-serif text-xl font-semibold text-slate-900">Nearby states</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {neighbours.map((n) => {
            const slug = slugify(n);
            return published.has(slug) ? (
              <li>
                <a
                  href={`/states/${slug}`}
                  class="inline-block rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium text-slate-800 hover:border-accent-700 hover:text-accent-800"
                >
                  {n}
                </a>
              </li>
            ) : (
              <li class="inline-block rounded-full border border-dashed border-slate-300 px-4 py-1.5 text-sm text-slate-600">
                {n} <span class="text-xs">(guide coming soon)</span>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {
    (prev || next) && (
      <div class="grid gap-3 sm:grid-cols-2">
        {prev ? (
          <a href={`/states/${prev.data.slug}`} rel="prev" class="rounded-xl border border-slate-200 p-4 hover:border-accent-700">
            <span class="block text-xs font-semibold tracking-wide text-slate-600 uppercase">← Previous</span>
            <span class="font-serif text-lg font-semibold text-slate-900">{prev.data.name}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={`/states/${next.data.slug}`} rel="next" class="rounded-xl border border-slate-200 p-4 text-right hover:border-accent-700">
            <span class="block text-xs font-semibold tracking-wide text-slate-600 uppercase">Next →</span>
            <span class="font-serif text-lg font-semibold text-slate-900">{next.data.name}</span>
          </a>
        )}
      </div>
    )
  }
</nav>
