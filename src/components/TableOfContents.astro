---
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="On this page" class="lg:sticky lg:top-20">
  <details id="toc" open class="group rounded-xl border border-slate-200 bg-white p-4 lg:border-0 lg:p-0">
    <summary class="cursor-pointer list-none text-sm font-semibold tracking-wide text-slate-900 uppercase lg:pointer-events-none lg:cursor-default">
      <span class="flex items-center justify-between">
        On this page
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 transition group-open:rotate-180 lg:hidden" fill="currentColor"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path></svg>
      </span>
    </summary>
    <ol class="mt-3 space-y-0.5 border-l border-slate-200 text-sm">
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-toc-link={item.id}
              class="-ml-px block border-l-2 border-transparent py-1.5 pl-3 text-slate-700 hover:border-slate-400 hover:text-slate-900 data-[active]:border-accent-700 data-[active]:font-medium data-[active]:text-accent-800"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<script>
  const toc = document.getElementById('toc') as HTMLDetailsElement | null;
  if (toc) {
    // Open by default (works without JS); collapse on small screens.
    const wide = window.matchMedia('(min-width: 1024px)');
    const sync = () => (toc.open = wide.matches);
    sync();
    wide.addEventListener('change', sync);

    // Collapse after choosing a section on mobile.
    toc.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && !wide.matches) toc.open = false;
    });

    // Highlight the section currently in view.
    const links = new Map<string, HTMLElement>();
    toc.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const current = [...links.keys()].find((id) => visible.has(id));
        if (!current) return;
        links.forEach((a, id) => a.toggleAttribute('data-active', id === current));
      },
      { rootMargin: '-72px 0px -65% 0px' },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) io.observe(section);
    });
  }
</script>
