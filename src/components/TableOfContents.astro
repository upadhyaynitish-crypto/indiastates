---
/**
 * Section navigation. Below `lg` it is a sticky, horizontally scrolling row
 * of chips under the site header; from `lg` up it is a sticky sidebar list.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav
  aria-label="On this page"
  class="sticky top-14 z-[1000] -mx-4 min-w-0 border-b border-slate-200 bg-white/90 backdrop-blur sm:-mx-6 lg:top-20 lg:mx-0 lg:border-0 lg:bg-transparent lg:backdrop-blur-none"
>
  <p class="hidden text-[11px] font-semibold tracking-[0.12em] text-slate-500 uppercase lg:block">On this page</p>
  <ol
    data-toc
    class="relative flex snap-x scroll-px-4 gap-2 overflow-x-auto px-4 py-2.5 [scrollbar-width:none] sm:px-6 lg:mt-3 lg:flex-col lg:gap-0.5 lg:overflow-visible lg:border-l lg:border-slate-200 lg:p-0 [&::-webkit-scrollbar]:hidden"
  >
    {
      items.map((item, i) => (
        <li class="shrink-0 snap-start">
          <a
            href={`#${item.id}`}
            data-toc-link={item.id}
            class="flex min-h-9 items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 text-sm whitespace-nowrap text-slate-700 transition hover:border-slate-400 data-[active]:border-slate-900 data-[active]:bg-slate-900 data-[active]:text-white lg:-ml-px lg:min-h-0 lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:bg-transparent lg:py-1.5 lg:pl-3 lg:whitespace-normal lg:data-[active]:border-accent-700 lg:data-[active]:bg-transparent lg:data-[active]:font-semibold lg:data-[active]:text-accent-800"
          >
            <span class="hidden font-mono text-[11px] text-slate-400 lg:inline" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const list = document.querySelector<HTMLElement>('[data-toc]');
  if (list) {
    const links = new Map<string, HTMLElement>();
    list.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    const visible = new Set<string>();
    let current = '';
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const next = [...links.keys()].find((id) => visible.has(id));
        if (!next || next === current) return;
        current = next;
        links.forEach((a, id) => a.toggleAttribute('data-active', id === current));
        // Keep the active chip in view on the horizontal (mobile) bar.
        const active = links.get(current)!;
        if (list.scrollWidth > list.clientWidth) {
          list.scrollTo({ left: active.offsetLeft - 16, behavior: 'smooth' });
        }
      },
      { rootMargin: '-120px 0px -60% 0px' },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) io.observe(section);
    });
  }
</script>
