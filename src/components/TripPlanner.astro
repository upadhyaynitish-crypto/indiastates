---
import type { CollectionEntry } from 'astro:content';
import { listJoin } from '../lib/format';

interface Props {
  state: CollectionEntry<'states'>['data'];
}
const { state } = Astro.props;
const { best_time_to_visit: best, airports } = state;
const languages = [...state.official_languages, ...state.other_languages];
---

{
  (best || airports.length > 0) && (
    <section aria-labelledby="plan-title" class="mt-6 overflow-hidden rounded-3xl bg-slate-900 text-white">
      <div class="grid gap-px bg-white/10 md:grid-cols-3">
        <div class="bg-slate-900 p-5 sm:p-6">
          <h2 id="plan-title" class="text-[11px] font-semibold tracking-[0.12em] text-teal-300 uppercase">
            Plan your trip · Best time
          </h2>
          {best ? (
            <>
              <p class="mt-2 font-display text-2xl font-bold">{best.months}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-white/75">{best.note}</p>
            </>
          ) : (
            <p class="mt-2 text-sm text-white/75">See the climate section below.</p>
          )}
        </div>

        <div class="bg-slate-900 p-5 sm:p-6">
          <h3 class="text-[11px] font-semibold tracking-[0.12em] text-teal-300 uppercase">Fly into</h3>
          <ul class="mt-3 space-y-2.5">
            {airports.map((a) => (
              <li class="flex items-center gap-3">
                <span class="grid h-9 min-w-12 place-items-center rounded-lg bg-white/10 px-2 font-mono text-sm font-semibold tracking-wider">
                  {a.code}
                </span>
                <span class="min-w-0 text-sm leading-snug">
                  <span class="block font-medium">{a.name}</span>
                  <span class="text-white/65">{a.city}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-slate-900 p-5 sm:p-6">
          <h3 class="text-[11px] font-semibold tracking-[0.12em] text-teal-300 uppercase">Good to know</h3>
          <dl class="mt-3 space-y-3 text-sm">
            <div>
              <dt class="text-white/65">Languages</dt>
              <dd class="font-medium">{listJoin(languages)}</dd>
            </div>
            <div>
              <dt class="text-white/65">Getting around</dt>
              <dd>
                <a href="#getting-there-air-rail-road" class="font-medium underline underline-offset-2 hover:text-teal-200">
                  Air, rail and road options
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  )
}
