---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  state: CollectionEntry<'states'>['data'];
}
const { state } = Astro.props;
const pending = state.needs_verification.length;
---

<!-- The site's promise, made checkable on every guide: how many sources, how fresh, what's still open. -->
<a
  href="#sources"
  class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl bg-accent-50 px-4 py-3 text-sm text-slate-800 ring-1 ring-accent-700/15 transition hover:ring-accent-700/40"
>
  <span class="inline-flex items-center gap-1.5 font-semibold text-accent-800">
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-[18px] w-[18px]" fill="currentColor"><path fill-rule="evenodd" d="M10 1.5 3 4.2v5.1c0 4.3 2.9 8 7 9.2 4.1-1.2 7-4.9 7-9.2V4.2L10 1.5Zm3.7 6.2a1 1 0 0 0-1.4-1.4L9 9.6 7.7 8.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd"></path></svg>
    Sourced guide
  </span>
  <span>{state.sources.length} sources cited</span>
  <span>Population from Census {state.population.year}</span>
  <span>Updated {formatDate(state.last_updated)}</span>
  {pending > 0 && <span>{pending} {pending === 1 ? 'detail' : 'details'} still being checked</span>}
  <span class="ml-auto inline-flex items-center gap-1 font-semibold text-accent-800">
    See sources
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor"><path d="M10 3a1 1 0 0 1 1 1v9.59l3.3-3.3a1 1 0 1 1 1.4 1.42l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.42L9 13.6V4a1 1 0 0 1 1-1Z"></path></svg>
  </span>
</a>
