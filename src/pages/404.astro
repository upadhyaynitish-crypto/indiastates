---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist on IndiaStates." noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent-800 uppercase">404</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold text-slate-900">Page not found</h1>
    <p class="mt-4 text-slate-700">The guide you're looking for may not be published yet.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-accent-700 px-5 py-2.5 font-semibold text-white hover:bg-accent-800">See all states &amp; UTs</a>
  </div>
</BaseLayout>
