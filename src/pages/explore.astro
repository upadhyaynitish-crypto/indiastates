---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCredits from '../components/PhotoCredits.astro';
import { getPlaces } from '../lib/places';
import { MONTH_NAMES } from '../lib/months';
import { INTERESTS, spotTypeLabel } from '../lib/format';

const places = await getPlaces();
const stateCount = new Set(places.map((p) => p.slug)).size;
const interests = INTERESTS.map((i) => ({ ...i, count: places.filter((p) => p.type === i.type).length })).filter((i) => i.count);

const chip =
  'inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border border-slate-300 bg-white px-3.5 text-sm font-semibold whitespace-nowrap text-slate-800 transition hover:border-slate-900 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white';
---

<BaseLayout
  title="Find places to visit in India by interest and month"
  description={`Filter ${places.length} places across ${stateCount} Indian states by what you love (forts, wildlife, waterfalls, beaches) and the month you're travelling.`}
>
  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 sm:pt-12">
    <p class="text-sm font-semibold text-accent-800">Trip finder</p>
    <h1 class="mt-2 max-w-3xl font-display text-[clamp(2.2rem,6.5vw,3.75rem)] leading-[1.02] font-bold tracking-[-0.03em] text-balance text-slate-900">
      Find places by what you love and when you’re going
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-slate-700">
      {places.length} places across {stateCount} states, each with a photo, the best months to visit and a link to the full guide.
    </p>

    <!-- Filters need JavaScript; without it every place is simply listed. -->
    <div data-filters hidden class="mt-8 space-y-3">
      <div>
        <p id="interest-label" class="text-xs font-semibold tracking-[0.12em] text-slate-600 uppercase">I’m interested in</p>
        <div role="group" aria-labelledby="interest-label" class="relative -mx-4 mt-2 flex scroll-px-4 gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
          <button type="button" class={chip} data-interest="" aria-pressed="true">Everything</button>
          {
            interests.map((i) => (
              <button type="button" class={chip} data-interest={i.type} aria-pressed="false">
                {i.label} <span class="text-xs font-medium opacity-70">{i.count}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div>
        <p id="month-label" class="text-xs font-semibold tracking-[0.12em] text-slate-600 uppercase">Travelling in</p>
        <div role="group" aria-labelledby="month-label" class="relative -mx-4 mt-2 flex scroll-px-4 gap-1.5 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
          <button type="button" class={chip} data-month="" aria-pressed="true">Any month</button>
          {
            MONTH_NAMES.map((m, i) => (
              <button type="button" class={chip} data-month={i + 1} aria-pressed="false" aria-label={m}>
                {m.slice(0, 3)}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-slate-200 pt-4">
      <p data-count aria-live="polite" class="font-semibold text-slate-900">{places.length} places</p>
      <button type="button" data-clear hidden class="text-sm font-semibold text-accent-800 underline underline-offset-2 hover:text-slate-900">Clear filters</button>
    </div>

    <!-- Phones: a compact row per place (thumbnail + text). Tablet and up: photo cards. -->
    <ul data-places class="mt-5 grid gap-3 sm:grid-cols-2 sm:gap-x-5 sm:gap-y-8 lg:grid-cols-3">
      {
        places.map((p) => (
          <li data-type={p.type} data-months={p.months.join(' ')}>
            <article class="group relative flex h-full gap-4 rounded-2xl border border-slate-200 p-3 sm:flex-col sm:gap-0 sm:border-0 sm:p-0">
              <figure class="relative h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-sand-100 sm:h-auto sm:w-full sm:rounded-2xl">
                {p.image ? (
                  <Image
                    src={p.image.src}
                    alt={p.image.alt}
                    widths={[200, 400, 640]}
                    sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 96px"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03] sm:aspect-[4/3] sm:h-auto"
                  />
                ) : (
                  <div class="grid h-full w-full place-items-center bg-gradient-to-br from-accent-50 to-sand-100 text-xs text-slate-600 sm:aspect-[4/3] sm:text-sm">
                    No photo yet
                  </div>
                )}
                <span class="pointer-events-none absolute top-3 right-3 hidden rounded-full bg-slate-900/75 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-white backdrop-blur sm:block">
                  {spotTypeLabel(p.type)}
                </span>
              </figure>
              <div class="flex min-w-0 flex-1 flex-col">
                <p class="text-[11px] font-semibold tracking-wide text-accent-800 uppercase sm:mt-3 sm:text-xs">
                  {p.state}<span class="text-slate-500 sm:hidden"> · {spotTypeLabel(p.type)}</span>
                </p>
                <h2 class="mt-0.5 font-display text-base leading-snug font-bold text-slate-900 sm:text-lg">
                  <a href={`/states/${p.slug}#spot-${p.number}`} class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent-800">
                    {p.name}
                  </a>
                </h2>
                <p class="mt-1 line-clamp-2 text-sm leading-snug text-slate-700 sm:line-clamp-3 sm:text-[15px] sm:leading-relaxed">{p.description}</p>
                <p class="mt-auto pt-2 text-[13px] text-slate-700 sm:pt-3 sm:text-sm">
                  <span class="font-semibold text-slate-900">Best time:</span>{' '}{p.best_time}
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div data-empty hidden class="mt-6 rounded-3xl bg-sand-50 p-6 text-slate-700 ring-1 ring-sand-200/70">
      <p class="font-semibold text-slate-900">No places match yet.</p>
      <p class="mt-1">Try another month or interest. Most of the states published so far are at their best from October to March, and more guides are being added.</p>
    </div>

    <PhotoCredits
      class="mt-10"
      items={places.filter((p) => p.image).map((p) => ({ label: `${p.name} (${p.state})`, image: p.image! }))}
    />

    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-slate-600">
      Best months come from the season notes in each guide. They are general guidance, not a forecast: check local conditions, park opening dates and festival calendars before you travel.
    </p>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  if (root) {
    root.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('[data-places] > li')];
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
    const interestButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-interest]')];
    const monthButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-month]')];

    const params = new URLSearchParams(location.search);
    let interest = interestButtons.some((b) => b.dataset.interest === params.get('interest')) ? params.get('interest')! : '';
    let month = /^(?:[1-9]|1[0-2])$/.test(params.get('month') ?? '') ? params.get('month')! : '';

    const label = (buttons: HTMLButtonElement[], value: string, attr: 'interest' | 'month') => {
      const b = buttons.find((x) => x.dataset[attr] === value);
      return b?.getAttribute('aria-label') ?? b?.firstChild?.textContent?.trim() ?? '';
    };

    function apply() {
      let shown = 0;
      for (const li of items) {
        const ok =
          (!interest || li.dataset.type === interest) && (!month || li.dataset.months!.split(' ').includes(month));
        li.hidden = !ok;
        if (ok) shown++;
      }
      interestButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.interest === interest)));
      monthButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.month === month)));

      const parts = [interest && label(interestButtons, interest, 'interest').toLowerCase(), month && `good in ${label(monthButtons, month, 'month')}`];
      count.textContent = `${shown} ${shown === 1 ? 'place' : 'places'}${parts.filter(Boolean).length ? ' · ' + parts.filter(Boolean).join(' · ') : ''}`;
      empty.hidden = shown > 0;
      clear.hidden = !interest && !month;

      const q = new URLSearchParams();
      if (interest) q.set('interest', interest);
      if (month) q.set('month', month);
      history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
    }

    interestButtons.forEach((b) => b.addEventListener('click', () => ((interest = b.dataset.interest!), apply())));
    monthButtons.forEach((b) => b.addEventListener('click', () => ((month = b.dataset.month!), apply())));
    clear.addEventListener('click', () => ((interest = ''), (month = ''), apply()));
    apply();

    // On phones the chip rows scroll sideways; bring a filter picked from the URL into view.
    for (const b of root.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"]')) {
      const row = b.parentElement!;
      row.scrollLeft = b.offsetLeft - (row.clientWidth - b.offsetWidth) / 2;
    }
  }
</script>
