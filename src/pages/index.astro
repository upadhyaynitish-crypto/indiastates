---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

const states = (await getCollection('states')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title={SITE.name}
  description="A free, independent guide to India's 28 states and 8 union territories: places to visit, history, culture, food, geography and how to get there."
>
  <section class="bg-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold tracking-[0.14em] text-accent-800 uppercase">28 states · 8 union territories</p>
      <h1 class="mt-2 max-w-3xl font-serif text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
        Explore India, one state at a time
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-700">
        One clear, sourced page for every state and union territory: what to see, what to eat, a little history, and how to get there.
      </p>
    </div>
  </section>

  <section aria-labelledby="guides-title" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="guides-title" class="font-serif text-2xl font-semibold text-slate-900">State &amp; UT guides</h2>
      <p class="text-sm text-slate-600">{states.length} of {SITE.totalRegions} published</p>
    </div>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        states.map(({ data }) => (
          <li>
            <a
              href={`/states/${data.slug}`}
              class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-accent-700 hover:shadow-md"
            >
              <Image
                src={data.hero_image.src}
                alt=""
                widths={[400, 640, 960]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                class="aspect-[16/9] w-full object-cover"
              />
              <div class="p-4">
                <p class="text-xs font-semibold tracking-wide text-slate-600 uppercase">
                  {data.type === 'state' ? 'State' : 'Union territory'} · {data.region}
                </p>
                <h3 class="mt-1 font-serif text-xl font-semibold text-slate-900 group-hover:text-accent-800">{data.name}</h3>
                <p class="mt-1 line-clamp-2 text-sm text-slate-700">{data.tagline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
