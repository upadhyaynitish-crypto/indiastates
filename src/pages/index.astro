---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

const states = (await getCollection('states')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title={SITE.name}
  description="A free, independent guide to India's 28 states and 8 union territories: places to visit, history, culture, food, geography and how to get there."
>
  <section class="relative isolate overflow-hidden border-b border-slate-200 bg-sand-50">
    <!-- Soft colour wash + faint grid; purely decorative. -->
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="absolute -top-32 -right-24 h-[28rem] w-[28rem] rounded-full bg-accent-100/70 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-24 h-[24rem] w-[24rem] rounded-full bg-amber-100/70 blur-3xl"></div>
      <div
        class="absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)] opacity-[0.35]"
        style="background-image: linear-gradient(to right, rgb(15 118 110 / 0.12) 1px, transparent 1px), linear-gradient(to bottom, rgb(15 118 110 / 0.12) 1px, transparent 1px); background-size: 44px 44px;"
      >
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 sm:pt-20 sm:pb-24">
      <p class="inline-flex items-center gap-2 rounded-full border border-accent-700/20 bg-white/70 px-3 py-1 text-xs font-semibold text-accent-800 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-600" aria-hidden="true"></span>
        28 states · 8 union territories
      </p>
      <h1
        class="mt-5 max-w-4xl font-display text-[clamp(2.6rem,8.5vw,5.25rem)] leading-[0.98] font-bold tracking-[-0.035em] text-balance text-slate-900"
      >
        Explore India,{' '}
        <span class="block w-fit bg-gradient-to-r from-accent-700 via-teal-600 to-emerald-600 bg-clip-text text-transparent">one state at a time.</span>
      </h1>
      <p class="mt-6 max-w-xl text-[clamp(1.05rem,2.2vw,1.25rem)] leading-relaxed text-pretty text-slate-700">
        One clear page for every state and union territory: what to see, what to eat, a little history, and how to get there.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#guides-title"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-slate-900 px-6 font-semibold text-white shadow-sm transition hover:bg-accent-800"
        >
          Browse the guides
          <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor"><path d="M10 3a1 1 0 0 1 1 1v9.59l3.3-3.3a1 1 0 1 1 1.4 1.42l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.42L9 13.6V4a1 1 0 0 1 1-1Z"></path></svg>
        </a>
        <a
          href="/search"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white/80 px-6 font-semibold text-slate-900 transition hover:border-slate-900"
        >
          Search places
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700">
        {
          ['Every fact sourced', 'Free, no sign-up', 'Independent, not a government site'].map((t) => (
            <li class="flex items-center gap-2">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 text-accent-700" fill="currentColor"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z"></path></svg>
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="guides-title" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="guides-title" class="font-display text-2xl font-semibold text-slate-900">State &amp; UT guides</h2>
      <p class="text-sm text-slate-600">{states.length} of {SITE.totalRegions} published</p>
    </div>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        states.map(({ data }) => (
          <li>
            <a
              href={`/states/${data.slug}`}
              class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-accent-700 hover:shadow-md"
            >
              <Image
                src={data.hero_image.src}
                alt=""
                widths={[400, 640, 960]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                class="aspect-[16/9] w-full object-cover"
              />
              <div class="p-4">
                <p class="text-xs font-semibold tracking-wide text-slate-600 uppercase">
                  {data.type === 'state' ? 'State' : 'Union territory'} · {data.region}
                </p>
                <h3 class="mt-1 font-display text-xl font-semibold text-slate-900 group-hover:text-accent-800">{data.name}</h3>
                <p class="mt-1 line-clamp-2 text-sm text-slate-700">{data.tagline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
