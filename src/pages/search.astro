---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every IndiaStates guide for places, festivals, food, history and more." noindex>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  </Fragment>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-slate-900">Search</h1>
    <div class="mt-6 space-y-4">
      <pagefind-input autofocus></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
    <noscript><p class="mt-6 text-slate-700">Search needs JavaScript. You can browse all guides from the <a class="underline" href="/">home page</a>.</p></noscript>
  </div>
</BaseLayout>
